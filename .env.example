# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Uso exclusivo do servidor — nunca exponha no frontend
SUPABASE_SERVICE_ROLE_KEY=

# IA — AI Gateway (servidor apenas)
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Modelos alternativos da Groq, tentados após limite/indisponibilidade do principal
GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b

# Aplicação
NEXT_PUBLIC_SITE_URL=http://localhost:3000
